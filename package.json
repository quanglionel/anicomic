{
  "name": "cpc-monitor",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev:web": "pnpm --filter @cpc/web dev",
    "dev:api": "pnpm --filter @cpc/api dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "deploy:api": "pnpm --filter @cpc/api deploy",
    "build:web:pages": "pnpm --filter @cpc/web build:pages",
    "deploy:web:pages": "pnpm --filter @cpc/web deploy:pages"
  }
}
